{
  "name": "near-rehearsal",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Bounded NEAR release rehearsal: capture existing contract state, apply a declared migration, compare the same user operation, and export a rerunnable regression.",
  "scripts": {
    "setup": "npm ci --ignore-scripts && node scripts/patch-near-sandbox.cjs",
    "compile": "node scripts/compile-contracts.cjs",
    "rehearse": "node rehearse.cjs",
    "replay": "node rehearse.cjs --replay out/capture.json",
    "verify": "node scripts/verify-report.cjs",
    "public": "node public-rehearse.cjs",
    "replay:public": "node public-rehearse.cjs --replay out/public-regression.json",
    "verify:public": "node scripts/verify-public-report.cjs",
    "verify:oracle": "node scripts/verify-oracle.cjs",
    "review:packet": "node scripts/build-release-review.cjs",
    "test:refund": "node scripts/test-refund-transfer.cjs",
    "rehearse:refund": "node scripts/refund-three-way.cjs",
    "test:guards": "node scripts/test-refund-guards.cjs",
    "ui": "node ui/server.cjs",
    "ui:review": "node ui/sputnik/server.cjs",
    "export:refund": "node scripts/export-refund-replay.cjs",
    "verify:refund": "node scripts/verify-refund-report.cjs",
    "verify:refund-export": "node scripts/verify-refund-export.cjs",
    "replay:refund-export": "node scripts/replay-refund-export.cjs",
    "test:export": "node scripts/test-export-guards.cjs",
    "test:ui": "node scripts/test-ui-polling.cjs",
    "test:amount": "node scripts/test-amount-regression.cjs",
    "ui:sputnik": "node ui/sputnik/server.cjs",
    "test:ui-upload": "node ui/sputnik/test-upload-selection.cjs",
    "test:classification": "node case-triage/sputnik-public-capture/test-classification.cjs",
    "test:operation-classification": "node scripts/test-operation-classification.cjs",
    "test:release-review": "node scripts/test-release-review-guards.cjs",
    "test": "node scripts/test-core.cjs",
    "doctor": "node scripts/check-setup.cjs",
    "ui:repair": "node scripts/start-rehearsal.cjs --flow repair",
    "ui:patch": "node scripts/start-rehearsal.cjs --flow repair --mode patch",
    "repair:review": "node scripts/repair-review.cjs",
    "review:patch": "node scripts/review-patch.cjs",
    "test:review-patch": "node scripts/test-review-patch.cjs",
    "test:repair-review": "node scripts/test-repair-review.cjs",
    "test:patch-route": "node ui/sputnik/test-patch-lifecycle.cjs && node ui/sputnik/test-patch-persistence.cjs && node ui/sputnik/test-patch-ui.cjs && node ui/sputnik/test-patch-package.cjs",
    "test:review": "node ui/sputnik/test-review-job.cjs && node ui/sputnik/test-review-ui.cjs && node ui/sputnik/test-review-polling.cjs && node ui/sputnik/test-review-stale.cjs && node ui/sputnik/test-review-selection.cjs && node ui/sputnik/test-review-process-tree.cjs && node ui/sputnik/test-review-start-race.cjs && node ui/sputnik/test-review-submit-lock.cjs && node ui/sputnik/test-patch-lifecycle.cjs && node ui/sputnik/test-patch-persistence.cjs && node ui/sputnik/test-patch-ui.cjs && node ui/sputnik/test-patch-package.cjs"
  },
  "dependencies": {
    "near-workspaces": "5.0.0"
  },
  "devDependencies": {
    "wabt": "1.0.36"
  }
}
