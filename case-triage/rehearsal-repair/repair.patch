+    /// Settles a proposal-bond refund only after the transfer receipt succeeds.
+    /// A failed transfer restores the debt; a stale or duplicate callback is ignored.
+    #[private]
+    pub fn on_refund_callback(&mut self, proposal_id: u64, attempt: u64) -> PromiseOrValue<()> {
+        assert_eq!(
+            env::promise_results_count(),
+            1,
+            "ERR_UNEXPECTED_REFUND_CALLBACK_PROMISES"
+        );
+        let (status, current_attempt, bond) = Self::read_refund_state(proposal_id)
+            .unwrap_or_else(|| env::panic_str("ERR_INVALID_REFUND_STATE"));
+        if status != Self::REFUND_IN_FLIGHT || current_attempt != attempt {
+            log!(
+                "Ignoring stale refund callback for proposal {} attempt {}",
+                proposal_id,
+                attempt
+            );
+            return PromiseOrValue::Value(());
+        }
+        if utils::is_promise_success() {
+            self.locked_amount = self
+                .locked_amount
+                .saturating_sub(NearToken::from_yoctonear(bond));
+            Self::write_refund_state(proposal_id, Self::REFUND_SETTLED, attempt, bond);
+        } else {
+            Self::write_refund_state(proposal_id, Self::REFUND_FAILED, attempt, bond);
+        }
+        PromiseOrValue::Value(())
